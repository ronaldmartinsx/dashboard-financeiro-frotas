SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.<project-ref>
PGPASSWORD=
PG_DSN=postgresql://<user>:<senha>@<host>:5432/postgres

# Leitura executiva (opcional). Sem esta chave o bloco na pagina de Metas
# explica como ligar e nenhum numero da tela muda.
ANTHROPIC_API_KEY=
