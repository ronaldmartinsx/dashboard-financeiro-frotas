# Regerar o snapshot de dados/ a partir do banco de origem.
# Usado so por scripts/exportar_dados.py; o app nunca le esta variavel.
PG_DSN=postgresql://<user>:<senha>@<host>:5432/postgres

# Leitura executiva (opcional). Sem esta chave o bloco na pagina de Metas
# explica como ligar e nenhum numero da tela muda.
ANTHROPIC_API_KEY=
